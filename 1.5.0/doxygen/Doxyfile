# SNEPPX-Algo Doxygen Configuration
# Run: doxygen Doxyfile

PROJECT_NAME           = "SNEPPX-Algo"
PROJECT_NUMBER         = "1.1.1"
PROJECT_BRIEF          = "Secure Neural Algorithm Pipeline"
OUTPUT_DIRECTORY       = output
CREATE_SUBDIRS         = YES
FULL_PATH_NAMES        = NO

INPUT                  = ../../include/neural_core
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.hpp *.c *.cpp *.cuh *.cu
EXCLUDE_PATTERNS       = */asm/*

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HTML_OUTPUT            = html
HTML_TIMESTAMP         = YES
HTML_COLORSTYLE_HUE    = 220
HTML_COLORSTYLE_SAT    = 100
HTML_COLORSTYLE_GAMMA  = 80

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = __cplusplus SNEPPX_STATIC_INLINE=static inline

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
SORT_MEMBER_DOCS       = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
QUIET                  = NO
